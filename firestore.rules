rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // PUBLIC READ, ADMIN WRITE
    // ==========================================
    
    // All portfolio data (projects, skills, experience, etc.)
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Public site settings (SEO, toggles)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ==========================================
    // PUBLIC CREATE, ADMIN READ/WRITE
    // ==========================================
    
    // Inbox for contact form submissions (collection is named 'contacts')
    match /contacts/{document=**} {
      allow create: if true; // Anyone can send a message
      allow read, update, delete: if request.auth != null; // Only admin can read/manage
    }

    // ==========================================
    // ADMIN ONLY
    // ==========================================
    
    // Admin configuration, session logs, authorized users
    match /admin/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
