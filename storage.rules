rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if user is the master admin
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.email == 'tanishkmangal3@gmail.com');
    }

    // Certifications: public read, admin write
    match /certifications/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Resume: public read, admin write
    match /resume/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Project images: public read, admin write
    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Assets: public read, admin write
    match /assets/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
